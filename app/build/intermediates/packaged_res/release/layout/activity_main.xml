<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a0a30">

    <!-- 遊戲畫面 -->
    <com.sharn.gravitymaze.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 暫停按鈕 -->
    <Button
        android:id="@+id/pauseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="暫停"
        android:visibility="gone"
        android:backgroundTint="#663399"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

    <!-- 主選單 -->
    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#1a0a30"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重力滾球"
            android:textSize="48sp"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:shadowColor="#FF8C00"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="5"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="時空迷宮"
            android:textSize="28sp"
            android:textColor="#00CED1"
            android:layout_marginBottom="60dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="開始遊戲"
            android:textSize="20sp"
            android:backgroundTint="#9932CC"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/menuRestartButton"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="重新開始"
            android:textSize="18sp"
            android:backgroundTint="#444444"
            android:textColor="#CCCCCC"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="傾斜手機控制鋼珠移動"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginTop="40dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="避開黑洞，收集徽章，解鎖密技！"
            android:textSize="14sp"
            android:textColor="#888888" />

    </LinearLayout>

    <!-- 遊戲結束畫面 -->
    <LinearLayout
        android:id="@+id/gameOverLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:visibility="gone"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="遊戲結束"
            android:textSize="40sp"
            android:textColor="#FF4444"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/gameOverReasonText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="掉入黑洞"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/restartButton"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:text="重新挑戰"
            android:textSize="18sp"
            android:backgroundTint="#FF6B6B" />

        <Button
            android:id="@+id/menuButton"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:text="返回主選單"
            android:textSize="18sp"
            android:backgroundTint="#444444"
            android:layout_marginTop="20dp" />

    </LinearLayout>

    <!-- 關卡完成畫面 -->
    <LinearLayout
        android:id="@+id/levelCompleteLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:visibility="gone"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉 關卡完成！"
            android:textSize="40sp"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/badgesCollectedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="收集徽章:\n無"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/cheatCodeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔓 密技解鎖: GODMODE"
            android:textSize="16sp"
            android:textColor="#00FF00"
            android:visibility="gone"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/nextLevelButton"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:text="下一關"
            android:textSize="20sp"
            android:backgroundTint="#32CD32" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
